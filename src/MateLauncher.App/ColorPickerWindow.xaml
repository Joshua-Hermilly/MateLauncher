<Window x:Class="MateLauncher.App.ColorPickerWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:loc="clr-namespace:MateLauncher.App.Localization"
		Title="{loc:Tr Color_Title}" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
		Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
	<StackPanel Margin="24">
		<TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" />

		<Border Margin="0,16,0,0" Height="160" CornerRadius="10" ClipToBounds="True" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
			<Grid x:Name="SvArea" Cursor="Cross" Background="Red" SizeChanged="OnAreaSizeChanged"
				  MouseLeftButtonDown="OnSvMouseDown" MouseMove="OnSvMouseMove" MouseLeftButtonUp="OnAreaMouseUp">
				<Rectangle>
					<Rectangle.Fill>
						<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
							<GradientStop Color="#FFFFFFFF" Offset="0" />
							<GradientStop Color="#00FFFFFF" Offset="1" />
						</LinearGradientBrush>
					</Rectangle.Fill>
				</Rectangle>
				<Rectangle>
					<Rectangle.Fill>
						<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
							<GradientStop Color="#00000000" Offset="0" />
							<GradientStop Color="#FF000000" Offset="1" />
						</LinearGradientBrush>
					</Rectangle.Fill>
				</Rectangle>
				<Canvas IsHitTestVisible="False">
					<Ellipse x:Name="SvThumb" Width="18" Height="18" Stroke="White" StrokeThickness="2">
						<Ellipse.Effect>
							<DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" Color="Black" />
						</Ellipse.Effect>
					</Ellipse>
				</Canvas>
			</Grid>
		</Border>

		<Grid x:Name="HueArea" Height="20" Margin="0,12,0,0" Cursor="Hand" Background="Transparent" SizeChanged="OnAreaSizeChanged"
			  MouseLeftButtonDown="OnHueMouseDown" MouseMove="OnHueMouseMove" MouseLeftButtonUp="OnAreaMouseUp">
			<Border CornerRadius="10" Height="14">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Color="#FF0000" Offset="0" />
						<GradientStop Color="#FFFF00" Offset="0.1667" />
						<GradientStop Color="#00FF00" Offset="0.3333" />
						<GradientStop Color="#00FFFF" Offset="0.5" />
						<GradientStop Color="#0000FF" Offset="0.6667" />
						<GradientStop Color="#FF00FF" Offset="0.8333" />
						<GradientStop Color="#FF0000" Offset="1" />
					</LinearGradientBrush>
				</Border.Background>
			</Border>
			<Canvas IsHitTestVisible="False">
				<Border x:Name="HueThumb" Width="8" Height="22" Canvas.Top="-1" CornerRadius="4" Background="White" BorderBrush="#88000000" BorderThickness="1" />
			</Canvas>
		</Grid>

		<ItemsControl x:Name="SwatchList" Margin="0,16,0,0">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<WrapPanel />
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<Button Width="34" Height="34" Margin="0,0,8,8" Background="{Binding Brush}" Cursor="Hand" Click="OnSwatchClicked" ToolTip="{Binding Hex}">
						<Button.Template>
							<ControlTemplate TargetType="Button">
								<Border x:Name="Ring" CornerRadius="17" Background="{TemplateBinding Background}" BorderThickness="2" BorderBrush="Transparent" />
								<ControlTemplate.Triggers>
									<Trigger Property="IsMouseOver" Value="True">
										<Setter TargetName="Ring" Property="BorderBrush" Value="White" />
									</Trigger>
									<Trigger Property="IsKeyboardFocused" Value="True">
										<Setter TargetName="Ring" Property="BorderBrush" Value="White" />
									</Trigger>
								</ControlTemplate.Triggers>
							</ControlTemplate>
						</Button.Template>
					</Button>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<Grid Margin="0,8,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Border x:Name="Preview" Width="38" Height="38" CornerRadius="19" Background="{DynamicResource CardBrush}" />
			<TextBox x:Name="HexBox" Grid.Column="1" Margin="12,0,0,0" Padding="10,9" FontSize="14" BorderThickness="0" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" TextChanged="OnHexChanged" />
		</Grid>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="{loc:Tr Color_Reset}" Style="{StaticResource AccentButton}" Background="#26FFFFFF" Margin="0,0,8,0" Click="OnResetClicked" />
			<Button Content="{loc:Tr Btn_Cancel}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="0,0,8,0" IsCancel="True" />
			<Button Content="{loc:Tr Btn_Ok}" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOkClicked" />
		</StackPanel>
	</StackPanel>
</Window>
