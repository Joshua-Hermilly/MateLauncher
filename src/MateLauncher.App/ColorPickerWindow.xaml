<Window x:Class="MateLauncher.App.ColorPickerWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:MateLauncher.App.Controls"
		xmlns:loc="clr-namespace:MateLauncher.App.Localization"
		Title="{loc:Tr Color_Title}" Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
		Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
	<StackPanel Margin="24">
		<TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" />
		<controls:ColorPickerControl x:Name="Picker" Margin="0,16,0,0" />

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="{loc:Tr Color_Reset}" Style="{StaticResource AccentButton}" Background="#26FFFFFF" Margin="0,0,8,0" Click="OnResetClicked" />
			<Button Content="{loc:Tr Btn_Cancel}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="0,0,8,0" IsCancel="True" />
			<Button Content="{loc:Tr Btn_Ok}" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOkClicked" />
		</StackPanel>
	</StackPanel>
</Window>
