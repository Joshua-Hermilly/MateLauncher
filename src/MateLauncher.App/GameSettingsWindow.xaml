<Window x:Class="MateLauncher.App.GameSettingsWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:loc="clr-namespace:MateLauncher.App.Localization"
		Title="{loc:Tr Config_Title}" Width="640" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
		Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
	<Window.Resources>
		<Style x:Key="FieldBox" TargetType="TextBox">
			<Setter Property="Background" Value="{DynamicResource CardBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
			<Setter Property="CaretBrush" Value="{DynamicResource TextBrush}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="10,9" />
			<Setter Property="FontSize" Value="14" />
		</Style>
		<Style x:Key="ChipStyle" TargetType="RadioButton">
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border x:Name="Chip" CornerRadius="15" Padding="14,6" Margin="0,0,8,8" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
							<ContentPresenter />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentBrush}" />
								<Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Margin" Value="0,14,0,5" />
		</Style>
	</Window.Resources>
	<StackPanel Margin="24">
		<TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" />
		<TextBlock x:Name="PlatformText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />

		<TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Config_Name}" />
		<TextBox x:Name="NameBox" Style="{StaticResource FieldBox}" />

		<TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Config_Executable}" />
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBox x:Name="ExecutableBox" Style="{StaticResource FieldBox}" />
			<Button Grid.Column="1" Content="{loc:Tr Btn_Browse}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="8,0,0,0" Click="OnBrowseExecutableClicked" />
		</Grid>

		<TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Config_Arguments}" />
		<TextBox x:Name="ArgumentsBox" Style="{StaticResource FieldBox}" />

		<TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Config_InstallPath}" />
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBox x:Name="InstallPathBox" Style="{StaticResource FieldBox}" />
			<Button Grid.Column="1" Content="{loc:Tr Btn_Browse}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="8,0,0,0" Click="OnBrowseInstallPathClicked" />
		</Grid>

		<TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Config_Category}" />
		<WrapPanel x:Name="CategoryPanel" />

		<TextBlock Style="{StaticResource FieldLabel}" Text="{loc:Tr Config_Cover}" />
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<TextBox x:Name="CoverBox" Style="{StaticResource FieldBox}" />
			<Button Grid.Column="1" Content="{loc:Tr Btn_Browse}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="8,0,0,0" Click="OnBrowseCoverClicked" />
		</Grid>
		<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
			<Button x:Name="SearchCoverButton" Content="{loc:Tr Config_SearchOnline}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Click="OnSearchCoverClicked" />
			<Button Content="{loc:Tr Config_Google}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="8,0,0,0" Click="OnGoogleClicked" />
			<Button Content="{loc:Tr Config_Paste}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="8,0,0,0" Click="OnPasteClicked" />
		</StackPanel>
		<TextBlock Text="{loc:Tr Config_PasteHint}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0" />

		<CheckBox x:Name="AdministratorBox" Content="{loc:Tr Config_Admin}" Foreground="{DynamicResource TextBrush}" Margin="0,18,0,0" />

		<TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

		<Grid Margin="0,22,0,0">
			<Button x:Name="ResetButton" Content="{loc:Tr Config_Reset}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" HorizontalAlignment="Left" Click="OnResetClicked" />
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="{loc:Tr Btn_Cancel}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="0,0,8,0" IsCancel="True" />
				<Button Content="{loc:Tr Btn_Save}" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnSaveClicked" />
			</StackPanel>
		</Grid>
	</StackPanel>
</Window>
