										<Slider Width="220" Minimum="140" Maximum="280" Value="{Binding CardWidth, Mode=TwoWay}" VerticalAlignment="Center" />
										<TextBlock Text="{Binding CardWidth, StringFormat={}{0:0} px}" Width="60" TextAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
									</StackPanel>
								</Grid>

								<Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,18" />

								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="{loc:Tr Appearance_Mode}" FontSize="15" FontWeight="SemiBold" />
										<TextBlock Text="{loc:Tr Appearance_ModeDesc}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
									</StackPanel>
									<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
										<Button Content="{loc:Tr Appearance_Grid}" Command="{Binding ShowGridCommand}">
