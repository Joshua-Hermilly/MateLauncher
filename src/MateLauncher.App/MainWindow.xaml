												CommandParameter="{Binding}" />
									</Grid>
									<DataTemplate.Triggers>
										<DataTrigger Binding="{Binding IsSelected}" Value="True">
											<Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextBrush}" />
										</DataTrigger>
									</DataTemplate.Triggers>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

