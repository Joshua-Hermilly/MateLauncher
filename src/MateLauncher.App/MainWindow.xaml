										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="{loc:Tr Appearance_CardSize}" FontSize="15" FontWeight="SemiBold" />
										<TextBlock Text="{loc:Tr Appearance_CardSizeDesc}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
