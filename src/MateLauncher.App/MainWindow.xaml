						<TextBlock Text="{loc:Tr About_Text}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,24,0,0" />
						<TextBlock Text="{loc:Tr About_License}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,12,0,0" />
						<TextBlock Text="{loc:Tr Update_Title}" Style="{StaticResource SectionTitle}" Margin="0,32,0,10" />
						<Border Style="{StaticResource OutlineCard}">
							<StackPanel>
								<TextBlock Text="{Binding CurrentVersionText}" FontWeight="SemiBold" />
								<TextBlock Text="{loc:Tr Update_Desc}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" />
								<CheckBox Content="{loc:Tr Update_Auto}" IsChecked="{Binding CheckUpdatesOnStartup}" Margin="0,12,0,0" />
								<StackPanel Orientation="Horizontal" Margin="0,14,0,0">
									<Button Content="{loc:Tr Update_Check}" Style="{StaticResource AccentButton}" Command="{Binding CheckForUpdatesCommand}" />
									<Button Content="{loc:Tr Update_Install}" Style="{StaticResource AccentButton}" Background="#2FD08A" Margin="8,0,0,0" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}" />
								</StackPanel>
								<ProgressBar Minimum="0" Maximum="1" Height="6" Margin="0,12,0,0" Value="{Binding UpdateProgress}" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BackgroundBrush}" BorderThickness="0" Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibility}}" />
								<TextBlock Text="{Binding UpdateStatusText}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
							</StackPanel>
						</Border>
					</StackPanel>
					<StackPanel>
						<StackPanel.Style>
							<Style TargetType="StackPanel">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding SettingsSectionIndex}" Value="4">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</StackPanel.Style>

						<TextBlock Text="{loc:Tr Settings_Credits}" Style="{StaticResource PageTitle}" />
						<TextBlock Text="{loc:Tr Credits_Subtitle}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />

						<TextBlock Text="{loc:Tr Credits_Author}" Style="{StaticResource SectionTitle}" Margin="0,28,0,10" />
						<Border Style="{StaticResource OutlineCard}">
							<StackPanel Orientation="Horizontal">
								<controls:MateLogo Width="56" Height="56" />
								<StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
									<TextBlock Text="Joshua Hermilly" FontSize="18" FontWeight="Bold" />
									<TextBlock Text="{loc:Tr Credits_AuthorRole}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
								</StackPanel>
							</StackPanel>
						</Border>

						<TextBlock Text="{loc:Tr Credits_Tech}" Style="{StaticResource SectionTitle}" Margin="0,26,0,10" />
						<Border Style="{StaticResource OutlineCard}">
							<StackPanel>
								<TextBlock Text="{loc:Tr Credits_TechList}" TextWrapping="Wrap" LineHeight="22" />
							</StackPanel>
						</Border>

						<TextBlock Text="{loc:Tr Credits_Data}" Style="{StaticResource SectionTitle}" Margin="0,26,0,10" />
						<Border Style="{StaticResource OutlineCard}">
							<TextBlock Text="{loc:Tr Credits_DataList}" TextWrapping="Wrap" LineHeight="22" />
						</Border>

						<TextBlock Text="{loc:Tr Credits_Trademarks}" Style="{StaticResource SectionTitle}" Margin="0,26,0,10" />
						<Border Style="{StaticResource OutlineCard}">
							<TextBlock Text="{loc:Tr Credits_TrademarksText}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="22" />
						</Border>

						<TextBlock Text="{loc:Tr Credits_License}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,22,0,0" />
					</StackPanel>
				</Grid>
			</ScrollViewer>
		</Grid>
	</Grid>
	</DockPanel>
</Window>