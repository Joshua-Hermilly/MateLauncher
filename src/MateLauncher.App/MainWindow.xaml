<Window x:Class="MateLauncher.App.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:MateLauncher.App.Controls"
		xmlns:loc="clr-namespace:MateLauncher.App.Localization"
		Icon="Assets/MateLauncher.png"
		Title="MateLauncher" Height="780" Width="1320" MinWidth="900" MinHeight="520"
		Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
	<WindowChrome.WindowChrome>
		<WindowChrome CaptionHeight="38" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
	</WindowChrome.WindowChrome>
	<Window.InputBindings>
		<KeyBinding Key="Escape" Command="{Binding CloseDetailCommand}" />
	</Window.InputBindings>
	<Window.Resources>
		<Style x:Key="SectionTitle" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
		</Style>
		<Style x:Key="PageTitle" TargetType="TextBlock">
			<Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
			<Setter Property="FontSize" Value="30" />
			<Setter Property="FontWeight" Value="Bold" />
		</Style>
		<Style x:Key="NavHeader" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
		</Style>
		<Style x:Key="OutlineCard" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource CardBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="20" />
		</Style>
		<Style x:Key="PageOverlay" TargetType="Grid">
			<Setter Property="Background" Value="{DynamicResource BackgroundBrush}" />
		</Style>
	</Window.Resources>
	<DockPanel x:Name="RootPanel">
		<Border DockPanel.Dock="Top" Height="38" Background="{DynamicResource SidebarBrush}">
			<Grid>
				<StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
					<Image Source="Assets/MateLauncher.png" Width="18" Height="18" />
					<TextBlock Text="MateLauncher" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
					<Border CornerRadius="9" Padding="8,1" Margin="10,0,0,0" Background="#22FFFFFF" VerticalAlignment="Center">
						<TextBlock Text="{Binding VersionBadge}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
					</Border>
				</StackPanel>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
					<StackPanel.Style>
						<Style TargetType="StackPanel">
							<Style.Triggers>
								<DataTrigger Binding="{Binding ActiveGame}" Value="{x:Null}">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</StackPanel.Style>
					<Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
					<TextBlock Text="{loc:Tr TitleBar_Playing}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
					<TextBlock Text="{Binding ActiveGame.Name}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
				</StackPanel>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
					<Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClicked" Content="&#xE921;" />
					<Button Style="{StaticResource CaptionButton}" Click="OnMaximizeClicked">
						<TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="10" />
					</Button>
					<Button Style="{StaticResource CaptionCloseButton}" Click="OnCloseClicked" Content="&#xE8BB;" />
				</StackPanel>

				<Rectangle Height="2" VerticalAlignment="Bottom">
					<Rectangle.Fill>
						<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
							<GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
							<GradientStop Color="#00000000" Offset="0.7" />
						</LinearGradientBrush>
					</Rectangle.Fill>
				</Rectangle>
			</Grid>
		</Border>
		<Border DockPanel.Dock="Top" Background="{DynamicResource AccentBrush}" Padding="16,7" Visibility="{Binding IsUpdateBannerVisible, Converter={StaticResource BoolToVisibility}}">
			<DockPanel>
				<Button DockPanel.Dock="Right" Content="{loc:Tr Update_Later}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Padding="12,4" FontSize="12" Margin="8,0,0,0" Command="{Binding DismissUpdateBannerCommand}" />
				<Button DockPanel.Dock="Right" Content="{loc:Tr Update_Install}" Style="{StaticResource AccentButton}" Background="#44000000" Padding="12,4" FontSize="12" Command="{Binding InstallUpdateCommand}" IsEnabled="{Binding CanInstallUpdate}" />
				<TextBlock Text="{Binding UpdateBannerText}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
			</DockPanel>
		</Border>
		<Border DockPanel.Dock="Top" Background="#E5484D" Padding="16,7" Visibility="{Binding IsSafeMode, Converter={StaticResource BoolToVisibility}}">
			<DockPanel>
				<Button DockPanel.Dock="Right" Content="{loc:Tr Safe_Restart}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Padding="12,4" FontSize="12" Command="{Binding RestartNormalCommand}" />
				<TextBlock Text="{loc:Tr Safe_Banner}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
			</DockPanel>
		</Border>		<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Border Background="{DynamicResource SidebarBrush}" Padding="14,22,14,16">
			<DockPanel>
				<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22">
					<controls:MateLogo Width="42" Height="42" />
					<TextBlock Text="MateLauncher" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
				</StackPanel>

				<Button DockPanel.Dock="Bottom" Style="{StaticResource AccentButton}" Command="{Binding SyncCommand}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE895;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
						<TextBlock Text="{loc:Tr Btn_Sync}" />
					</StackPanel>
				</Button>

				<Button DockPanel.Dock="Bottom" Style="{StaticResource AccentButton}" Background="#26FFFFFF" Margin="0,0,0,8" Command="{Binding OpenAddChoiceCommand}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
						<TextBlock Text="{loc:Tr Btn_AddManual}" />
					</StackPanel>
				</Button>

				<Button DockPanel.Dock="Bottom" Style="{StaticResource AccentButton}" Background="#26FFFFFF" Margin="0,0,0,8" Command="{Binding OpenSettingsCommand}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
						<TextBlock Text="{loc:Tr Btn_Settings}" />
					</StackPanel>
				</Button>

				<ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10" PreviewMouseWheel="OnSidebarMouseWheel">
					<StackPanel>
						<Expander Style="{StaticResource SectionExpander}">
							<Expander.Header>
								<TextBlock Text="{loc:Tr Nav_Library}" Style="{StaticResource NavHeader}" />
							</Expander.Header>
							<ListBox ItemsSource="{Binding LibraryItems}" SelectedItem="{Binding SelectedLibraryItem}"
									 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
									 ItemContainerStyle="{StaticResource NavItemStyle}" ItemTemplate="{StaticResource NavItemTemplate}" />
						</Expander>

						<Expander Style="{StaticResource SectionExpander}" Margin="0,10,0,0">
							<Expander.Header>
								<TextBlock Text="{loc:Tr Nav_Platforms}" Style="{StaticResource NavHeader}" />
							</Expander.Header>
							<ListBox ItemsSource="{Binding PlatformItems}" SelectedItem="{Binding SelectedPlatformItem}"
									 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
									 ItemContainerStyle="{StaticResource NavItemStyle}" ItemTemplate="{StaticResource NavItemTemplate}" />
						</Expander>

						<Expander Style="{StaticResource SectionExpander}" Margin="0,10,0,0">
							<Expander.Header>
								<Grid>
									<TextBlock Text="{loc:Tr Nav_Categories}" Style="{StaticResource NavHeader}" VerticalAlignment="Center" />
									<Button Style="{StaticResource CircleButton}" Width="22" Height="22" Background="#26FFFFFF" HorizontalAlignment="Right" Margin="0,0,22,0"
											Command="{Binding AddCategoryCommand}" ToolTip="{loc:Tr Btn_NewCategory}">
										<TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" />
									</Button>
								</Grid>
							</Expander.Header>
							<ListBox ItemsSource="{Binding CategoryItems}" SelectedItem="{Binding SelectedCategoryItem}"
									 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
									 ItemContainerStyle="{StaticResource NavItemStyle}" ItemTemplate="{StaticResource NavItemTemplate}" />
						</Expander>

						<Expander Style="{StaticResource SectionExpander}" Margin="0,10,0,0" Visibility="{Binding HasGroups, Converter={StaticResource BoolToVisibility}}">
							<Expander.Header>
								<TextBlock Text="{loc:Tr Nav_Folders}" Style="{StaticResource NavHeader}" />
							</Expander.Header>
							<ListBox ItemsSource="{Binding GroupItems}" SelectedItem="{Binding SelectedGroupItem}"
									 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
									 ItemContainerStyle="{StaticResource NavItemStyle}" ItemTemplate="{StaticResource NavItemTemplate}" />
						</Expander>

						<Expander Style="{StaticResource SectionExpander}" Margin="0,10,0,0">
							<Expander.Header>
								<TextBlock Text="{loc:Tr Nav_Tools}" Style="{StaticResource NavHeader}" />
							</Expander.Header>
							<ListBox ItemsSource="{Binding ToolItems}" SelectedItem="{Binding SelectedToolItem}"
									 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
									 ItemContainerStyle="{StaticResource NavItemStyle}" ItemTemplate="{StaticResource NavItemTemplate}" />
						</Expander>
					</StackPanel>
				</ScrollViewer>
			</DockPanel>
		</Border>

		<DockPanel x:Name="LibraryPage" Grid.Column="1" Margin="24,20,6,0">
			<Grid DockPanel.Dock="Top" Margin="8,0,18,16">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<Border Background="{DynamicResource CardBrush}" CornerRadius="8" MaxWidth="460" HorizontalAlignment="Left" Width="460">
					<Grid>
						<TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedTextBrush}"
								   VerticalAlignment="Center" Margin="14,0,0,0" HorizontalAlignment="Left" />
						<TextBlock Text="{loc:Tr Search_Placeholder}" Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False"
								   VerticalAlignment="Center" Margin="40,0,0,0">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
						<TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
								 Background="Transparent" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
								 BorderThickness="0" Padding="40,11,12,11" FontSize="14" />
					</Grid>
				</Border>

				<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
					<Button Height="36" Margin="0,0,10,0" Command="{Binding ToggleFilterPanelCommand}" ToolTip="{loc:Tr Filter_Title}" Padding="14,0">
							<Button.Style>
								<Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
									<Setter Property="Background" Value="#26FFFFFF" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsFilterPanelOpen}" Value="True">
											<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding HasActiveFilters}" Value="True">
											<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Button.Style>
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
								<TextBlock Text="{loc:Tr Filter_Title}" />
								<TextBlock Text="{Binding ActiveFilterCount, StringFormat=' ({0})'}" Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}" />
							</StackPanel>
						</Button>
						<Button Width="36" Height="36" Command="{Binding ShowGridCommand}" ToolTip="{loc:Tr Tip_Grid}">
						<Button.Style>
							<Style TargetType="Button" BasedOn="{StaticResource CircleButton}">
								<Setter Property="Background" Value="#26FFFFFF" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsListView}" Value="False">
										<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
						<TextBlock Text="&#xE80A;" FontFamily="{StaticResource IconFont}" FontSize="15" />
					</Button>
					<Button Width="36" Height="36" Margin="6,0,0,0" Command="{Binding ShowListCommand}" ToolTip="{loc:Tr Tip_List}">
						<Button.Style>
							<Style TargetType="Button" BasedOn="{StaticResource CircleButton}">
								<Setter Property="Background" Value="#26FFFFFF" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding IsListView}" Value="True">
										<Setter Property="Background" Value="{DynamicResource AccentBrush}" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
						<TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}" FontSize="15" />
					</Button>
				</StackPanel>
			</Grid>

			<Grid DockPanel.Dock="Top" Margin="8,0,18,10" Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVisibility}}">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<ItemsControl ItemsSource="{Binding ActiveFilters}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Style="{StaticResource ChipButton}" Background="{DynamicResource AccentBrush}"
									Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
								<StackPanel Orientation="Horizontal">
									<TextBlock Text="{Binding Label}" Foreground="White" />
									<TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="White" Margin="8,1,0,0" VerticalAlignment="Center" />
								</StackPanel>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
				<Button Grid.Column="1" Content="{loc:Tr Filter_Clear}" Command="{Binding ClearFiltersCommand}" Style="{StaticResource ChipButton}" Background="Transparent" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Top" />
			</Grid>
			<StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10,6,0,8">
				<TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
				<TextBlock Text="{Binding CoverStatusText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="16,0,0,0" />
			</StackPanel>

			<Border DockPanel.Dock="Right" Width="300" Margin="12,0,0,0" Padding="18,16,10,10" Background="{DynamicResource SidebarBrush}" CornerRadius="12" Visibility="{Binding IsFilterPanelOpen, Converter={StaticResource BoolToVisibility}}">
				<DockPanel>
					<Grid DockPanel.Dock="Top" Margin="0,0,8,12">
						<TextBlock Text="{loc:Tr Filter_Title}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
						<Button Content="{loc:Tr Filter_Clear}" Command="{Binding ClearFiltersCommand}" Style="{StaticResource ChipButton}" Background="#1FFFFFFF" HorizontalAlignment="Right" Margin="0" />
					</Grid>
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<StackPanel Margin="0,0,8,0">
							<TextBlock Text="{loc:Tr Filter_Sort}" Style="{StaticResource NavHeader}" Margin="0,0,0,8" />
							<WrapPanel>
								<Button Content="{loc:Tr Sort_Name}" Command="{Binding SetSortCommand}" CommandParameter="Name"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding SortMode}" Value="Name"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
								<Button Content="{loc:Tr Sort_Playtime}" Command="{Binding SetSortCommand}" CommandParameter="Playtime"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding SortMode}" Value="Playtime"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
								<Button Content="{loc:Tr Sort_LastPlayed}" Command="{Binding SetSortCommand}" CommandParameter="LastPlayed"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding SortMode}" Value="LastPlayed"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
								<Button Content="{loc:Tr Sort_Size}" Command="{Binding SetSortCommand}" CommandParameter="Size"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding SortMode}" Value="Size"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
								<Button Content="{loc:Tr Sort_Platform}" Command="{Binding SetSortCommand}" CommandParameter="Platform"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource ChipButton}"><Style.Triggers><DataTrigger Binding="{Binding SortMode}" Value="Platform"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
							</WrapPanel>
							<Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,10,0,12" />
							<ItemsControl ItemsSource="{Binding FilterGroups}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Expander Style="{StaticResource SectionExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,10">
											<Expander.Header>
												<TextBlock Text="{Binding Title}" Style="{StaticResource NavHeader}" />
											</Expander.Header>
											<ItemsControl ItemsSource="{Binding Options}" Margin="2,4,0,0">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<Grid Margin="0,4">
															<CheckBox Style="{StaticResource FilterCheckBox}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Content="{Binding Label}" />
															<TextBlock Text="{Binding Count}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False" />
														</Grid>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</Expander>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</ScrollViewer>
				</DockPanel>
			</Border>
			<Grid>
				<ListBox ItemsSource="{Binding Games}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
						 ItemContainerStyle="{StaticResource CardItemStyle}"
						 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
					<ListBox.Style>
						<Style TargetType="ListBox">
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsListView}" Value="True">
									<Setter Property="Visibility" Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ListBox.Style>
					<ListBox.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel SizeChanged="OnGameGridSizeChanged" />
						</ItemsPanelTemplate>
					</ListBox.ItemsPanel>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border x:Name="Card" CornerRadius="10" ClipToBounds="True" Background="{Binding PlaceholderBrush}"
									Width="{Binding DataContext.ActualCardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
									Height="{Binding DataContext.ActualCardHeight, RelativeSource={RelativeSource AncestorType=ListBox}}">
								<Grid>
									<TextBlock Visibility="{Binding HasNoCover, Converter={StaticResource BoolToVisibility}}" Text="{Binding Initials}" FontSize="44" FontWeight="Black" Foreground="#55FFFFFF"
											   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,30" />
									<Image Source="{Binding CoverImagePath}" Stretch="{Binding CoverImagePath, Converter={StaticResource CoverStretch}}" />

									<Border x:Name="Tint" Background="#88000000" Visibility="Collapsed" />

									<Border VerticalAlignment="Bottom" Padding="12,30,12,12">
										<Border.Background>
											<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
												<GradientStop Color="#00000000" Offset="0" />
												<GradientStop Color="#F0000000" Offset="1" />
											</LinearGradientBrush>
										</Border.Background>
										<StackPanel>
											<TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" />
											<TextBlock Text="{Binding PlatformLabel}" Foreground="{Binding PlatformBrush}" FontSize="11" Margin="0,3,0,0" />
										</StackPanel>
									</Border>

									<Button Style="{StaticResource CardOverlayButton}"
											Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
											CommandParameter="{Binding}" />

									<Button x:Name="PlayButton" Style="{StaticResource CircleButton}" Width="56" Height="56"
											HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,24"
											Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
											CommandParameter="{Binding}">
										<TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="22" Margin="3,0,0,0" />
									</Button>

									<Button x:Name="StopButton" Style="{StaticResource CircleButton}" Width="56" Height="56" Background="#E5484D"
											HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,24" ToolTip="{loc:Tr Btn_Stop}"
											Command="{Binding DataContext.StopGameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
											CommandParameter="{Binding}"
											Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
										<TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="20" />
									</Button>

									<Button x:Name="RemoveButton" Style="{StaticResource CircleButton}" Width="32" Height="32" Background="#99000000"
											HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Visibility="Collapsed" ToolTip="{loc:Tr Btn_Remove}"
											Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
											CommandParameter="{Binding}">
										<TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" />
									</Button>

									<Button x:Name="ConfigureButton" Style="{StaticResource CircleButton}" Width="32" Height="32" Background="#99000000"
											HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,48,0" Visibility="Collapsed" ToolTip="{loc:Tr Btn_Configure}"
											Command="{Binding DataContext.ConfigureGameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
											CommandParameter="{Binding}">
										<TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" />
									</Button>

									<Button x:Name="FavoriteButton" Style="{StaticResource CircleButton}" Width="32" Height="32" Background="#99000000"
											HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Visibility="Collapsed"
											Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
											CommandParameter="{Binding}">
										<TextBlock x:Name="FavoriteGlyph" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White" />
									</Button>
								</Grid>
							</Border>
							<DataTemplate.Triggers>
								<Trigger SourceName="Card" Property="IsMouseOver" Value="True">
									<Setter TargetName="PlayButton" Property="Visibility" Value="Visible" />
									<Setter TargetName="FavoriteButton" Property="Visibility" Value="Visible" />
									<Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
									<Setter TargetName="ConfigureButton" Property="Visibility" Value="Visible" />
									<Setter TargetName="Tint" Property="Visibility" Value="Visible" />
								</Trigger>
								<DataTrigger Binding="{Binding IsFavorite}" Value="True">
									<Setter TargetName="FavoriteButton" Property="Visibility" Value="Visible" />
									<Setter TargetName="FavoriteGlyph" Property="Text" Value="&#xE735;" />
									<Setter TargetName="FavoriteGlyph" Property="Foreground" Value="#FFD34D" />
								</DataTrigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<ListBox ItemsSource="{Binding Games}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
						 ItemContainerStyle="{StaticResource RowItemStyle}"
						 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
					<ListBox.Style>
						<Style TargetType="ListBox">
							<Setter Property="Visibility" Value="Collapsed" />
							<Style.Triggers>
								<DataTrigger Binding="{Binding IsListView}" Value="True">
									<Setter Property="Visibility" Value="Visible" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ListBox.Style>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Border x:Name="Row" CornerRadius="8" Background="{DynamicResource CardBrush}" Height="76">
								<Grid>
									<Button Style="{StaticResource CardOverlayButton}"
											Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
											CommandParameter="{Binding}" />
									<Grid Margin="10,0,14,0">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="56" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="90" />
											<ColumnDefinition Width="120" />
											<ColumnDefinition Width="160" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>

										<Border Width="46" Height="62" CornerRadius="5" ClipToBounds="True" Background="{Binding PlaceholderBrush}" IsHitTestVisible="False">
											<Grid>
												<TextBlock Visibility="{Binding HasNoCover, Converter={StaticResource BoolToVisibility}}" Text="{Binding Initials}" FontSize="16" FontWeight="Black" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
												<Image Source="{Binding CoverImagePath}" Stretch="{Binding CoverImagePath, Converter={StaticResource CoverStretch}}" />
											</Grid>
										</Border>

										<StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
											<TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
											<TextBlock Text="{Binding PlatformLabel}" Foreground="{Binding PlatformBrush}" FontSize="12" Margin="0,3,0,0" />
										</StackPanel>

										<StackPanel Grid.Column="2" VerticalAlignment="Center" IsHitTestVisible="False">
											<TextBlock Text="{loc:Tr Label_Size}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
											<TextBlock Text="{Binding SizeText}" Margin="0,3,0,0" />
										</StackPanel>

										<StackPanel Grid.Column="3" VerticalAlignment="Center" IsHitTestVisible="False">
											<TextBlock Text="{loc:Tr Label_Playtime}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
											<TextBlock Text="{Binding PlaytimeText}" Margin="0,3,0,0" />
										</StackPanel>

										<StackPanel Grid.Column="4" VerticalAlignment="Center" IsHitTestVisible="False">
											<TextBlock Text="{loc:Tr Label_LastPlayed}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
											<TextBlock Text="{Binding LastPlayedText}" Margin="0,3,0,0" />
										</StackPanel>

										<StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
											<Button Style="{StaticResource CircleButton}" Width="34" Height="34" Background="#26FFFFFF" Margin="0,0,8,0" ToolTip="{loc:Tr Btn_Remove}"
													Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
													CommandParameter="{Binding}">
												<TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" />
											</Button>
											<Button Style="{StaticResource CircleButton}" Width="34" Height="34" Background="#26FFFFFF" Margin="0,0,8,0" ToolTip="{loc:Tr Btn_Configure}"
													Command="{Binding DataContext.ConfigureGameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
													CommandParameter="{Binding}">
												<TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" />
											</Button>
											<Button Style="{StaticResource CircleButton}" Width="34" Height="34" Background="#26FFFFFF" Margin="0,0,10,0"
													Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
													CommandParameter="{Binding}">
												<TextBlock FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="White" Text="&#xE734;">
													<TextBlock.Style>
														<Style TargetType="TextBlock">
															<Style.Triggers>
																<DataTrigger Binding="{Binding IsFavorite}" Value="True">
																	<Setter Property="Text" Value="&#xE735;" />
																	<Setter Property="Foreground" Value="#FFD34D" />
																</DataTrigger>
															</Style.Triggers>
														</Style>
													</TextBlock.Style>
												</TextBlock>
											</Button>
											<Button Style="{StaticResource CircleButton}" Width="40" Height="40" Background="#E5484D" Margin="0,0,8,0" ToolTip="{loc:Tr Btn_Stop}"
													Command="{Binding DataContext.StopGameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
													CommandParameter="{Binding}"
													Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
												<TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="15" />
											</Button>
											<Button Style="{StaticResource CircleButton}" Width="40" Height="40"
													Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
													CommandParameter="{Binding}">
												<TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="2,0,0,0" />
											</Button>
										</StackPanel>
									</Grid>
								</Grid>
							</Border>
							<DataTemplate.Triggers>
								<Trigger SourceName="Row" Property="IsMouseOver" Value="True">
									<Setter TargetName="Row" Property="Background" Value="{DynamicResource CardHoverBrush}" />
								</Trigger>
							</DataTemplate.Triggers>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>
		</DockPanel>

		<Grid x:Name="DetailPage" Grid.Column="1" Background="{DynamicResource BackgroundBrush}" ClipToBounds="True">
			<Grid.Style>
				<Style TargetType="Grid">
					<Style.Triggers>
						<DataTrigger Binding="{Binding SelectedGame}" Value="{x:Null}">
							<Setter Property="Visibility" Value="Collapsed" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Grid.Style>

			<Image Source="{Binding SelectedGame.CoverImagePath}" Stretch="UniformToFill" Opacity="0.4" Margin="-80">
				<Image.Effect>
					<BlurEffect Radius="50" KernelType="Gaussian" />
				</Image.Effect>
			</Image>
			<Rectangle>
				<Rectangle.Fill>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Color="#33000000" Offset="0" />
						<GradientStop Color="{DynamicResource BackgroundColor}" Offset="1" />
					</LinearGradientBrush>
				</Rectangle.Fill>
			</Rectangle>

			<Button Style="{StaticResource AccentButton}" Background="#33000000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,24,0,0"
					Command="{Binding CloseDetailCommand}">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
					<TextBlock Text="{loc:Tr Btn_Back}" />
				</StackPanel>
			</Button>

			<StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,28,0" Orientation="Horizontal">
				<Button Style="{StaticResource AccentButton}" Background="#E5484D" Margin="0,0,8,0" Command="{Binding StopGameCommand}" CommandParameter="{Binding SelectedGame}"
						Visibility="{Binding SelectedGame.IsRunning, Converter={StaticResource BoolToVisibility}}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
						<TextBlock Text="{loc:Tr Btn_Stop}" />
					</StackPanel>
				</Button>
				<Button Style="{StaticResource AccentButton}" Background="#33000000" Command="{Binding ConfigureGameCommand}" CommandParameter="{Binding SelectedGame}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
						<TextBlock Text="{loc:Tr Btn_Configure}" />
					</StackPanel>
				</Button>
				<Button Style="{StaticResource AccentButton}" Background="#33000000" Margin="8,0,0,0" Command="{Binding RemoveGameCommand}" CommandParameter="{Binding SelectedGame}">
					<StackPanel Orientation="Horizontal">
						<TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
						<TextBlock Text="{loc:Tr Btn_Remove}" />
					</StackPanel>
				</Button>
			</StackPanel>

			<Grid Margin="56,90,56,40" VerticalAlignment="Top">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Border Width="260" Height="390" CornerRadius="12" ClipToBounds="True" VerticalAlignment="Top" Background="{Binding SelectedGame.PlaceholderBrush}">
					<Grid>
						<TextBlock Visibility="{Binding SelectedGame.HasNoCover, Converter={StaticResource BoolToVisibility}}" Text="{Binding SelectedGame.Initials}" FontSize="60" FontWeight="Black" Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
						<Image Source="{Binding SelectedGame.CoverImagePath}" Stretch="{Binding SelectedGame.CoverImagePath, Converter={StaticResource CoverStretch}}" />
					</Grid>
				</Border>

				<StackPanel Grid.Column="1" Margin="44,0,0,0">
					<TextBlock Text="{Binding SelectedGame.Name}" FontSize="38" FontWeight="Bold" TextWrapping="Wrap" />
					<TextBlock Text="{Binding SelectedGame.PlatformLabel}" Foreground="{Binding SelectedGame.PlatformBrush}" FontSize="15" Margin="0,6,0,0" />

					<StackPanel Orientation="Horizontal" Margin="0,28,0,0">
						<Button Style="{StaticResource AccentButton}" MinWidth="170" FontSize="16"
								Command="{Binding LaunchGameCommand}" CommandParameter="{Binding SelectedGame}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Margin="0,2,10,0" />
								<TextBlock Text="{loc:Tr Btn_Play}" />
							</StackPanel>
						</Button>
						<Button Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="12,0,0,0"
								Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedGame}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" Margin="0,2,8,0">
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Style.Triggers>
												<DataTrigger Binding="{Binding SelectedGame.IsFavorite}" Value="True">
													<Setter Property="Text" Value="&#xE735;" />
													<Setter Property="Foreground" Value="#FFD34D" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
								<TextBlock Text="{loc:Tr Btn_Favorite}" />
							</StackPanel>
						</Button>
						<Button Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="12,0,0,0"
								Command="{Binding OpenInstallFolderCommand}" CommandParameter="{Binding SelectedGame}"
								IsEnabled="{Binding SelectedGame.HasInstallPath}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" Margin="0,2,8,0" />
								<TextBlock Text="{loc:Tr Btn_OpenFolder}" />
							</StackPanel>
						</Button>
					</StackPanel>

					<WrapPanel Margin="0,40,0,0">
						<StackPanel Margin="0,0,48,16">
							<TextBlock Text="{loc:Tr Label_Playtime}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
							<TextBlock Text="{Binding SelectedGame.PlaytimeText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
						</StackPanel>
						<StackPanel Margin="0,0,48,16">
							<TextBlock Text="{loc:Tr Label_LastPlayed}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
							<TextBlock Text="{Binding SelectedGame.LastPlayedText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
						</StackPanel>
						<StackPanel Margin="0,0,48,16">
							<TextBlock Text="{loc:Tr Label_Size}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
							<TextBlock Text="{Binding SelectedGame.SizeText}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
						</StackPanel>
						<StackPanel Margin="0,0,48,16">
							<TextBlock Text="{loc:Tr Label_Platform}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
							<TextBlock Text="{Binding SelectedGame.PlatformLabel}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
						</StackPanel>
						<StackPanel Margin="0,0,48,16">
							<StackPanel.Style>
								<Style TargetType="StackPanel">
									<Style.Triggers>
										<DataTrigger Binding="{Binding SelectedGame.CategoryName}" Value="">
											<Setter Property="Visibility" Value="Collapsed" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</StackPanel.Style>
							<TextBlock Text="{loc:Tr Label_Category}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
							<TextBlock Text="{Binding SelectedGame.CategoryName}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" />
						</StackPanel>
					</WrapPanel>

					<TextBlock Text="{loc:Tr Label_Install}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,16,0,0" />
											<TextBlock Text="{Binding SelectedGame.InstallPath}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

						<StackPanel Margin="0,26,0,0" Visibility="{Binding ShowAchievements, Converter={StaticResource BoolToVisibility}}">
							<Grid>
								<TextBlock Text="{loc:Tr Ach_Title}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
								<TextBlock Text="{Binding AchievementsSummary}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
							</Grid>
							<ProgressBar Value="{Binding AchievementsProgress, Mode=OneWay}" Maximum="100" Height="5" Margin="0,8,0,8" BorderThickness="0" Background="#33FFFFFF" Foreground="{DynamicResource AccentBrush}" />
							<TextBlock Text="{Binding AchievementsStatus}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12.5" />
							<ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
								<ItemsControl ItemsSource="{Binding Achievements}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid Margin="0,0,10,8">
												<Grid.Style>
													<Style TargetType="Grid">
														<Setter Property="Opacity" Value="0.5" />
														<Style.Triggers>
															<DataTrigger Binding="{Binding IsUnlocked}" Value="True">
																<Setter Property="Opacity" Value="1" />
															</DataTrigger>
														</Style.Triggers>
													</Style>
												</Grid.Style>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>
												<Image Source="{Binding IconUrl}" Width="40" Height="40" Margin="0,0,12,0" />
												<StackPanel Grid.Column="1" VerticalAlignment="Center">
													<TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
													<TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
												</StackPanel>
												<StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
													<TextBlock Text="{Binding PercentText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Right" />
													<TextBlock Text="{Binding DateText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" HorizontalAlignment="Right" />
												</StackPanel>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</StackPanel>
				</StackPanel>
			</Grid>
		</Grid>

		<Grid x:Name="StatsPage" Grid.Column="1" Style="{StaticResource PageOverlay}" Visibility="{Binding IsStatsOpen, Converter={StaticResource BoolToVisibility}}">
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Margin="44,40,44,40">
					<TextBlock Text="{loc:Tr Stats_Title}" Style="{StaticResource PageTitle}" />
					<TextBlock Text="{loc:Tr Stats_Subtitle}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />

					<TextBlock Text="{loc:Tr Stats_NoData}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,20,0,0">
						<TextBlock.Style>
							<Style TargetType="TextBlock">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding Stats.HasData}" Value="False">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>

					<UniformGrid Columns="4" Margin="0,24,0,0">
						<Border Style="{StaticResource OutlineCard}" Margin="0,0,10,0">
							<StackPanel>
								<TextBlock Text="{loc:Tr Stats_Total}" Style="{StaticResource SectionTitle}" />
								<TextBlock Text="{Binding Stats.TotalText}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
							</StackPanel>
						</Border>
						<Border Style="{StaticResource OutlineCard}" Margin="0,0,10,0">
							<StackPanel>
								<TextBlock Text="{loc:Tr Stats_Games}" Style="{StaticResource SectionTitle}" />
								<TextBlock Text="{Binding Stats.GamesCountText}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
							</StackPanel>
						</Border>
						<Border Style="{StaticResource OutlineCard}" Margin="0,0,10,0">
							<StackPanel>
								<TextBlock Text="{loc:Tr Stats_Played}" Style="{StaticResource SectionTitle}" />
								<TextBlock Text="{Binding Stats.PlayedCountText}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
							</StackPanel>
						</Border>
						<Border Style="{StaticResource OutlineCard}">
							<StackPanel>
								<TextBlock Text="{loc:Tr Stats_Today}" Style="{StaticResource SectionTitle}" />
								<TextBlock Text="{Binding Stats.TodayText}" FontSize="22" FontWeight="Bold" Margin="0,8,0,0" />
							</StackPanel>
						</Border>
					</UniformGrid>

					<TextBlock Text="{loc:Tr Stats_Curve}" Style="{StaticResource SectionTitle}" Margin="0,30,0,12" />
					<Border Style="{StaticResource OutlineCard}" SizeChanged="OnStatsChartSizeChanged">
						<StackPanel>
							<TextBlock Text="{loc:Tr Stats_AxisHint}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5" Margin="0,0,0,10" />
							<Canvas Width="{Binding Stats.ChartWidth}" Height="200" HorizontalAlignment="Left">
								<ItemsControl ItemsSource="{Binding Stats.GridLines}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<Canvas />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemContainerStyle>
										<Style TargetType="ContentPresenter">
											<Setter Property="Canvas.Top" Value="{Binding Y}" />
										</Style>
									</ItemsControl.ItemContainerStyle>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid Width="{Binding Width}" Margin="70,0,0,0">
												<Rectangle Height="1" Fill="{DynamicResource BorderBrush}" />
												<TextBlock Text="{Binding Label}" Width="62" TextAlignment="Right" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Left" Margin="-70,-9,0,0" />
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<Polygon Points="{Binding Stats.AreaPoints}" Opacity="0.28">
									<Polygon.Fill>
										<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
											<GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
											<GradientStop Color="Transparent" Offset="1" />
										</LinearGradientBrush>
									</Polygon.Fill>
								</Polygon>
								<Polyline Points="{Binding Stats.CurvePoints}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" StrokeLineJoin="Round" />
								<ItemsControl ItemsSource="{Binding Stats.Dots}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<Canvas />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemContainerStyle>
										<Style TargetType="ContentPresenter">
											<Setter Property="Canvas.Left" Value="{Binding X}" />
											<Setter Property="Canvas.Top" Value="{Binding Y}" />
										</Style>
									</ItemsControl.ItemContainerStyle>
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Ellipse Width="10" Height="10" Margin="-5,-5,0,0" Fill="{DynamicResource BackgroundBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" ToolTip="{Binding Tooltip}" />
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Canvas>
							<ItemsControl ItemsSource="{Binding Stats.DayLabels}" Height="22" Width="{Binding Stats.ChartWidth}" HorizontalAlignment="Left" Margin="0,6,0,0">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<Canvas />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemContainerStyle>
									<Style TargetType="ContentPresenter">
										<Setter Property="Canvas.Left" Value="{Binding X}" />
									</Style>
								</ItemsControl.ItemContainerStyle>
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Text}" Width="44" Margin="-22,0,0,0" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

					<Grid Margin="0,30,0,0">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>

						<StackPanel Margin="0,0,24,0">
							<TextBlock Text="{loc:Tr Stats_TopGames}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
							<Border Style="{StaticResource OutlineCard}">
								<ItemsControl ItemsSource="{Binding Stats.TopGames}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<StackPanel Margin="0,0,0,12">
												<Grid>
													<TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,90,0" />
													<TextBlock Text="{Binding PlaytimeText}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" />
												</Grid>
												<ProgressBar Style="{StaticResource BarProgress}" Value="{Binding Ratio, Mode=OneWay}" Foreground="{Binding Brush}" Margin="0,6,0,0" />
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>
						</StackPanel>

						<StackPanel Grid.Column="1">
							<TextBlock Text="{loc:Tr Stats_Platforms}" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
							<Border Style="{StaticResource OutlineCard}">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
									<ItemsControl ItemsSource="{Binding Stats.Slices}" Width="180" Height="180">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<Canvas />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Path Data="{Binding Geometry}" Stroke="{Binding Brush}" StrokeThickness="22" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<ItemsControl ItemsSource="{Binding Stats.Slices}" Margin="20,0,0,0" VerticalAlignment="Center" MinWidth="130">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<StackPanel Orientation="Horizontal" Margin="0,4">
													<Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
													<TextBlock Text="{Binding Label}" Margin="8,0,0,0" />
													<TextBlock Text="{Binding PercentText}" Margin="8,0,0,0" Foreground="{DynamicResource MutedTextBrush}" />
												</StackPanel>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Border>
						</StackPanel>
					</Grid>
				</StackPanel>
			</ScrollViewer>
		</Grid>

		<Grid x:Name="DownloadsPage" Grid.Column="1" Style="{StaticResource PageOverlay}" Visibility="{Binding IsDownloadsOpen, Converter={StaticResource BoolToVisibility}}">
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Margin="44,40,44,40" MaxWidth="780" HorizontalAlignment="Left">
					<TextBlock Text="{loc:Tr Downloads_Title}" Style="{StaticResource PageTitle}" />
					<TextBlock Text="{loc:Tr Downloads_Subtitle}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />

					<Button Style="{StaticResource AccentButton}" Background="#26FFFFFF" HorizontalAlignment="Left" Margin="0,22,0,0" Command="{Binding RefreshUpdatesCommand}">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
							<TextBlock Text="{loc:Tr Downloads_Refresh}" />
						</StackPanel>
					</Button>

						<Border Style="{StaticResource OutlineCard}" Margin="0,22,0,0">
							<StackPanel>
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Ellipse Width="10" Height="10" VerticalAlignment="Center">
										<Ellipse.Style>
											<Style TargetType="Ellipse">
												<Setter Property="Fill" Value="#FF6B6B" />
												<Style.Triggers>
													<DataTrigger Binding="{Binding IsSteamRunning}" Value="True">
														<Setter Property="Fill" Value="#34C759" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</Ellipse.Style>
									</Ellipse>
									<TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding SteamStatusText}" />
									<Button Grid.Column="2" Content="{loc:Tr Downloads_OpenSteam}" Style="{StaticResource AccentButton}" Background="#26FFFFFF" FontSize="12" Command="{Binding StartSteamCommand}" />
								</Grid>

								<TextBlock Text="{loc:Tr Downloads_SearchTitle}" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<TextBox x:Name="SteamSearchBox" Text="{Binding DownloadSearchText, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" BorderThickness="0" Padding="12,10" FontSize="14">
										<TextBox.InputBindings>
											<KeyBinding Key="Enter" Command="{Binding SearchSteamCommand}" />
										</TextBox.InputBindings>
									</TextBox>
									<Button Grid.Column="1" Content="{loc:Tr Downloads_Search}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Command="{Binding SearchSteamCommand}" />
								</Grid>
								<TextBlock Text="{Binding SteamSearchStatus}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,8,0,0" />
								<ItemsControl ItemsSource="{Binding SteamResults}" Margin="0,8,0,0">
									<ItemsControl.ItemTemplate>
										<DataTemplate>
											<Grid Margin="0,6,0,0">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
												</Grid.ColumnDefinitions>
												<Image Source="{Binding ImageUrl}" Width="92" Height="43" Stretch="UniformToFill" />
												<StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
													<TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
													<TextBlock Text="{Binding PriceText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
												</StackPanel>
												<Button Grid.Column="2" Content="{loc:Tr Downloads_Install_Button}" Style="{StaticResource AccentButton}" FontSize="12"
														Command="{Binding DataContext.InstallSteamGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					<TextBlock Text="{loc:Tr Downloads_Pending}" Style="{StaticResource SectionTitle}" Margin="0,28,0,12" />
					<TextBlock Text="{loc:Tr Downloads_None}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
							   Visibility="{Binding HasNoUpdates, Converter={StaticResource BoolToVisibility}}" />
					<ItemsControl ItemsSource="{Binding PendingUpdates}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Style="{StaticResource OutlineCard}" Padding="18,14" Margin="0,0,0,10">
									<StackPanel>
										<Grid>
											<StackPanel>
												<TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
												<TextBlock Text="{Binding PlatformLabel}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
											</StackPanel>
											<TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
										</Grid>
										<ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="6" Margin="0,12,0,0" BorderThickness="0"
													 Background="#33FFFFFF" Foreground="{DynamicResource AccentBrush}" />
										<Grid Margin="0,6,0,0">
											<TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" VerticalAlignment="Center" />
											<Button Content="{loc:Tr Downloads_Start}" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" FontSize="12"
													Command="{Binding DataContext.StartDownloadCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
													CommandParameter="{Binding}" />
										</Grid>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock Text="{Binding DownloadsMessage}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />

					<TextBlock Text="{loc:Tr Downloads_OpenClients}" Style="{StaticResource SectionTitle}" Margin="0,30,0,12" />
					<WrapPanel>
						<Button Content="Steam" Style="{StaticResource AccentButton}" Background="#26FFFFFF" Margin="0,0,8,8" Command="{Binding OpenClientCommand}" CommandParameter="steam://nav/downloads" />
						<Button Content="Epic Games" Style="{StaticResource AccentButton}" Background="#26FFFFFF" Margin="0,0,8,8" Command="{Binding OpenClientCommand}" CommandParameter="com.epicgames.launcher://store" />
						<Button Content="Ubisoft Connect" Style="{StaticResource AccentButton}" Background="#26FFFFFF" Margin="0,0,8,8" Command="{Binding OpenClientCommand}" CommandParameter="uplay://" />
						<Button Content="EA App" Style="{StaticResource AccentButton}" Background="#26FFFFFF" Margin="0,0,8,8" Command="{Binding OpenClientCommand}" CommandParameter="origin2://library/open" />
						<Button Content="Battle.net" Style="{StaticResource AccentButton}" Background="#26FFFFFF" Margin="0,0,8,8" Command="{Binding OpenClientCommand}" CommandParameter="battlenet://" />
						<Button Content="Microsoft Store" Style="{StaticResource AccentButton}" Background="#26FFFFFF" Margin="0,0,8,8" Command="{Binding OpenClientCommand}" CommandParameter="ms-windows-store://downloadsandupdates" />
					</WrapPanel>
					<TextBlock Text="{loc:Tr Downloads_Note}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
				</StackPanel>
			</ScrollViewer>
		</Grid>

		<Grid x:Name="NewsPage" Grid.Column="1" Style="{StaticResource PageOverlay}" Visibility="{Binding IsNewsOpen, Converter={StaticResource BoolToVisibility}}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Margin="44,40,24,40">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel>
							<TextBlock Text="{loc:Tr News_Title}" Style="{StaticResource PageTitle}" />
							<TextBlock Text="{Binding NewsStatus}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
						</StackPanel>
						<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
							<Button Style="{StaticResource CircleButton}" Width="36" Height="36" Background="#26FFFFFF" Margin="0,0,8,0" Command="{Binding ToggleNewsPanelCommand}" ToolTip="{loc:Tr News_TogglePanel}">
								<TextBlock Text="&#xE8A0;" FontFamily="{StaticResource IconFont}" FontSize="14" />
							</Button>
							<Button Style="{StaticResource AccentButton}" Background="#26FFFFFF" Command="{Binding RefreshNewsCommand}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
								<TextBlock Text="{loc:Tr Downloads_Refresh}" />
								</StackPanel>
							</Button>
						</StackPanel>
					</Grid>

					<TextBlock Text="{loc:Tr News_None}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,24,0,0" Visibility="{Binding HasNoNews, Converter={StaticResource BoolToVisibility}}" />

					<ItemsControl ItemsSource="{Binding NewsItems}" Margin="0,20,0,0">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Style="{StaticResource OutlineCard}" Padding="16" Margin="0,0,0,12" Cursor="Hand" Background="{DynamicResource CardBrush}">
									<Border.InputBindings>
										<MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenClientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Link}" />
									</Border.InputBindings>
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Border Width="150" Height="84" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource BackgroundBrush}" Margin="0,0,16,0" Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
											<Image Source="{Binding ImageUrl}" Stretch="UniformToFill" />
										</Border>
										<StackPanel Grid.Column="1">
											<TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
												<Run Text="{Binding Source, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DateText, Mode=OneWay}" />
											</TextBlock>
											<TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
											<TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="54" TextTrimming="CharacterEllipsis" />
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</ScrollViewer>

			<Border Grid.Column="1" Width="300" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Padding="20,40,20,20" Visibility="{Binding IsNewsPanelOpen, Converter={StaticResource BoolToVisibility}}">
				<StackPanel>
					<TextBlock Text="{loc:Tr News_Sources}" Style="{StaticResource SectionTitle}" />
					<ItemsControl ItemsSource="{Binding NewsFeedEntries}" Margin="0,12,0,0">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid Margin="0,0,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
										<TextBlock Text="{Binding Url}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}" />
									</StackPanel>
									<Button Grid.Column="1" Style="{StaticResource CircleButton}" Width="30" Height="30" Background="#26FFFFFF" Margin="8,0,0,0" ToolTip="{loc:Tr Menu_Delete}"
											Command="{Binding DataContext.RemoveFeedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
										<TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" />
									</Button>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Button Style="{StaticResource AccentButton}" Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding AddFeedCommand}">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0" />
							<TextBlock Text="{loc:Tr News_AddFeed}" />
						</StackPanel>
					</Button>

					<Rectangle Height="1" Fill="{DynamicResource BorderBrush}" Margin="0,22" />
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel Margin="0,0,12,0">
							<TextBlock Text="{loc:Tr News_GameNews}" FontWeight="SemiBold" />
							<TextBlock Text="{loc:Tr News_GameNewsDesc}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
						</StackPanel>
						<CheckBox Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding IncludeGameNews, Mode=TwoWay}" VerticalAlignment="Center" />
					</Grid>
				</StackPanel>
			</Border>
		</Grid>
		<Grid x:Name="SettingsPage" Grid.Column="1" Background="{DynamicResource BackgroundBrush}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVisibility}}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="230" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="20,40,16,0">
				<StackPanel>
					<TextBlock Text="{loc:Tr Settings_Title}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold" Margin="8,0,0,24" />
					<ListBox SelectedIndex="{Binding SettingsSectionIndex}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}">
						<ListBoxItem Style="{StaticResource NavItemStyle}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" Width="30" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
								<TextBlock Text="{loc:Tr Settings_Appearance}" FontSize="14" VerticalAlignment="Center" />
							</StackPanel>
						</ListBoxItem>
						<ListBoxItem Style="{StaticResource NavItemStyle}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Width="30" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
								<TextBlock Text="{loc:Tr Settings_General}" FontSize="14" VerticalAlignment="Center" />
							</StackPanel>
						</ListBoxItem>
						<ListBoxItem Style="{StaticResource NavItemStyle}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" Width="30" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
								<TextBlock Text="{loc:Tr Settings_Library}" FontSize="14" VerticalAlignment="Center" />
							</StackPanel>
						</ListBoxItem>
						<ListBoxItem Style="{StaticResource NavItemStyle}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" Width="30" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
								<TextBlock Text="{loc:Tr Settings_About}" FontSize="14" VerticalAlignment="Center" />
							</StackPanel>
						</ListBoxItem>
						<ListBoxItem Style="{StaticResource NavItemStyle}">
							<StackPanel Orientation="Horizontal">
								<TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" Width="30" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
								<TextBlock Text="{loc:Tr Settings_Credits}" FontSize="14" VerticalAlignment="Center" />
							</StackPanel>
						</ListBoxItem>
					</ListBox>
				</StackPanel>
			</Border>

			<ScrollViewer x:Name="SettingsContent" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<Grid Margin="44,40,44,40" MaxWidth="780" HorizontalAlignment="Left">
					<StackPanel>
						<StackPanel.Style>
							<Style TargetType="StackPanel">
								<Setter Property="Visibility" Value="Collapsed" />
								<Style.Triggers>
									<DataTrigger Binding="{Binding SettingsSectionIndex}" Value="0">
										<Setter Property="Visibility" Value="Visible" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</StackPanel.Style>

						<TextBlock Text="{loc:Tr Settings_Appearance}" Style="{StaticResource PageTitle}" />
						<TextBlock Text="{loc:Tr Appearance_Subtitle}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />

						<DockPanel Margin="0,32,0,12">
	<Button DockPanel.Dock="Right" Content="{loc:Tr Theme_Create}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Padding="12,5" FontSize="12" Command="{Binding CreateThemeCommand}" />
	<TextBlock Text="{loc:Tr Appearance_Theme}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
</DockPanel>
						<ItemsControl ItemsSource="{Binding ThemeOptions}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<WrapPanel />
