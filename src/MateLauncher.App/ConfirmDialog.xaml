<Window x:Class="MateLauncher.App.ConfirmDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:loc="clr-namespace:MateLauncher.App.Localization"
		Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
		Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
	<StackPanel Margin="24">
		<TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14" LineHeight="21" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
			<Button Content="{loc:Tr Btn_Cancel}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="0,0,8,0" IsCancel="True" />
			<Button x:Name="ConfirmButton" Style="{StaticResource AccentButton}" Background="#E5484D" IsDefault="True" Click="OnConfirmClicked" />
		</StackPanel>
	</StackPanel>
</Window>
