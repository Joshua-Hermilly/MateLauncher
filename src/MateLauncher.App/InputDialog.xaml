<Window x:Class="MateLauncher.App.InputDialog"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:loc="clr-namespace:MateLauncher.App.Localization"
		Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
		Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
	<StackPanel Margin="24">
		<TextBlock x:Name="LabelText" Foreground="{DynamicResource MutedTextBrush}" />
		<TextBox x:Name="ValueBox" Margin="0,8,0,0" Padding="10,9" FontSize="14" BorderThickness="0"
				 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="{loc:Tr Btn_Cancel}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="0,0,8,0" IsCancel="True" />
			<Button Content="{loc:Tr Btn_Ok}" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOkClicked" />
		</StackPanel>
	</StackPanel>
</Window>
