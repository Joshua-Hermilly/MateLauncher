<Window x:Class="MateLauncher.App.SafeModeWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:loc="clr-namespace:MateLauncher.App.Localization"
		Title="{loc:Tr Safe_Title}" Width="640" SizeToContent="Height" MaxHeight="780" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
		Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
	<StackPanel Margin="26">
		<TextBlock Text="{loc:Tr Safe_Header}" FontSize="22" FontWeight="Bold" />
		<TextBlock x:Name="ReasonText" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

		<TextBlock x:Name="NoFolderText" Text="{loc:Tr Library_NoFolder}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,20,0,0" Visibility="Collapsed" />
		<TextBlock x:Name="FoldersLabel" Text="{loc:Tr Safe_Folders}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,20,0,8" />
		<ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
			<ItemsControl x:Name="FolderList">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Border CornerRadius="10" Background="{DynamicResource CardBrush}" Padding="14,10" Margin="0,0,0,8">
							<Border.Style>
								<Style TargetType="Border">
									<Style.Triggers>
										<DataTrigger Binding="{Binding IsRemoved}" Value="True">
											<Setter Property="Opacity" Value="0.4" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</Border.Style>
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<CheckBox Style="{StaticResource SwitchStyle}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
								<StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
									<TextBlock Text="{Binding TabName}" FontWeight="SemiBold" />
									<TextBlock Text="{Binding Path}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
								</StackPanel>
								<Button Grid.Column="2" Style="{StaticResource CircleButton}" Width="34" Height="34" Background="#26FFFFFF" ToolTip="{loc:Tr Library_RemoveFolder}" Click="OnRemoveClicked">
									<TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" />
								</Button>
							</Grid>
						</Border>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>

		<TextBlock Text="{loc:Tr Safe_Hint}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
			<Button Content="{loc:Tr Safe_Quit}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="0,0,8,0" IsCancel="True" />
			<Button Content="{loc:Tr Safe_StartSafe}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="0,0,8,0" Click="OnStartSafeClicked" />
			<Button Content="{loc:Tr Safe_StartNormal}" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnStartNormalClicked" />
		</StackPanel>
	</StackPanel>
</Window>
