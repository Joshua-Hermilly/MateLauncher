<Window x:Class="MateLauncher.App.ThemeEditorWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:MateLauncher.App.Controls"
		xmlns:loc="clr-namespace:MateLauncher.App.Localization"
		Title="{loc:Tr Theme_EditorTitle}" Width="900" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
		Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
	<StackPanel Margin="28,24,28,24">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="300" />
				<ColumnDefinition Width="28" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<StackPanel>
				<TextBlock Text="{loc:Tr Theme_Name}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
				<TextBox x:Name="NameBox" Padding="10,9" FontSize="14" BorderThickness="0" MaxLength="32" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" />

				<TextBlock Text="{loc:Tr Theme_Colors}" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
				<ListBox x:Name="FieldList" Foreground="{DynamicResource TextBrush}" Background="Transparent" BorderThickness="0" Padding="0" SelectionChanged="OnFieldSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
					<ListBox.ItemContainerStyle>
						<Style TargetType="ListBoxItem">
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ListBoxItem">
										<Border x:Name="Row" Margin="0,0,0,4" Padding="10,8" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Cursor="Hand">
											<ContentPresenter />
										</Border>
										<ControlTemplate.Triggers>
											<Trigger Property="IsMouseOver" Value="True">
												<Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBrush}" />
											</Trigger>
											<Trigger Property="IsSelected" Value="True">
												<Setter TargetName="Row" Property="Background" Value="{DynamicResource CardBrush}" />
												<Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
											</Trigger>
										</ControlTemplate.Triggers>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ListBox.ItemContainerStyle>
					<ListBox.ItemTemplate>
						<DataTemplate>
							<DockPanel>
								<Ellipse DockPanel.Dock="Left" Width="22" Height="22" Fill="{Binding Brush}" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" Margin="0,0,10,0" />
								<TextBlock DockPanel.Dock="Right" Text="{Binding Hex}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
								<TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
							</DockPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</StackPanel>

			<StackPanel Grid.Column="2">
				<TextBlock x:Name="SelectedLabel" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
				<controls:ColorPickerControl x:Name="Picker" HexChanged="OnPickerChanged" />

				<TextBlock Text="{loc:Tr Theme_Preview}" Style="{StaticResource SectionTitle}" Margin="0,20,0,8" />
				<Border x:Name="PreviewFrame" Height="150" CornerRadius="12" BorderThickness="1" ClipToBounds="True">
					<Grid>
						<Border x:Name="PreviewSidebar" HorizontalAlignment="Left" Width="56">
							<StackPanel Margin="0,14,0,0">
								<Ellipse x:Name="PreviewDot" Width="22" Height="22" />
								<Border x:Name="PreviewBar1" Width="26" Height="5" CornerRadius="3" Margin="0,18,0,0" />
								<Border x:Name="PreviewBar2" Width="26" Height="5" CornerRadius="3" Margin="0,10,0,0" />
							</StackPanel>
						</Border>
						<StackPanel Margin="76,16,18,14">
							<TextBlock x:Name="PreviewTitle" Text="MateLauncher" FontWeight="Bold" FontSize="16" />
							<TextBlock x:Name="PreviewMuted" Text="{loc:Tr Theme_PreviewText}" FontSize="12" Margin="0,2,0,12" />
							<StackPanel Orientation="Horizontal">
								<Border x:Name="PreviewCard" Width="110" Height="46" CornerRadius="8" Margin="0,0,10,0" />
								<Border x:Name="PreviewCardHover" Width="110" Height="46" CornerRadius="8" Margin="0,0,10,0" />
								<Border x:Name="PreviewButton" Height="28" Padding="14,0" CornerRadius="14" VerticalAlignment="Bottom">
									<TextBlock Text="Jouer" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
								</Border>
							</StackPanel>
						</StackPanel>
					</Grid>
				</Border>
			</StackPanel>
		</Grid>

		<DockPanel Margin="0,24,0,0">
			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
				<Button Content="{loc:Tr Theme_Export}" Style="{StaticResource AccentButton}" Background="#26FFFFFF" Margin="0,0,8,0" Click="OnExportClicked" />
				<Button Content="{loc:Tr Btn_Cancel}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="0,0,8,0" IsCancel="True" />
				<Button Content="{loc:Tr Btn_Ok}" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOkClicked" />
			</StackPanel>
			<Button x:Name="DeleteButton" Content="{loc:Tr Theme_Delete}" Style="{StaticResource AccentButton}" Background="#E5484D" HorizontalAlignment="Left" Click="OnDeleteClicked" Visibility="Collapsed" />
		</DockPanel>
	</StackPanel>
</Window>
