<Window x:Class="MateLauncher.App.ThemeEditorWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:loc="clr-namespace:MateLauncher.App.Localization"
		Title="{loc:Tr Theme_EditorTitle}" Width="720" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
		Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
	<StackPanel Margin="24">
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="250" />
			</Grid.ColumnDefinitions>

			<StackPanel>
				<TextBlock Text="{loc:Tr Theme_Name}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
				<TextBox x:Name="NameBox" Padding="10,9" FontSize="14" BorderThickness="0" Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}" MaxLength="32" />

				<ItemsControl x:Name="FieldList" Margin="0,16,0,0">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Grid Margin="0,0,0,8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="150" />
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
								<Button Grid.Column="1" Width="30" Height="30" Cursor="Hand" Click="OnSwatchClicked" ToolTip="{loc:Tr Theme_Pick}" Background="{Binding Brush}">
									<Button.Template>
										<ControlTemplate TargetType="Button">
											<Border x:Name="Ring" CornerRadius="15" Background="{TemplateBinding Background}" BorderThickness="2" BorderBrush="{DynamicResource BorderBrush}" />
											<ControlTemplate.Triggers>
												<Trigger Property="IsMouseOver" Value="True">
													<Setter TargetName="Ring" Property="BorderBrush" Value="White" />
												</Trigger>
											</ControlTemplate.Triggers>
										</ControlTemplate>
									</Button.Template>
								</Button>
								<TextBox Grid.Column="2" Margin="10,0,0,0" Padding="10,6" FontSize="13" BorderThickness="0" Background="{DynamicResource CardBrush}" CaretBrush="{DynamicResource TextBrush}" Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}">
									<TextBox.Style>
										<Style TargetType="TextBox">
											<Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsValid}" Value="False">
													<Setter Property="Foreground" Value="#FF6B6B" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBox.Style>
								</TextBox>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>

			<StackPanel Grid.Column="1" Margin="24,0,0,0">
				<TextBlock Text="{loc:Tr Theme_Preview}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
				<Border x:Name="PreviewFrame" Height="230" CornerRadius="12" BorderThickness="1">
					<Grid>
						<Border x:Name="PreviewSidebar" HorizontalAlignment="Left" Width="50" CornerRadius="11,0,0,11" />
						<StackPanel Margin="66,18,16,16">
							<TextBlock x:Name="PreviewTitle" Text="MateLauncher" FontWeight="Bold" FontSize="16" />
							<TextBlock x:Name="PreviewMuted" Text="{loc:Tr Theme_PreviewText}" FontSize="12" Margin="0,2,0,14" />
							<Border x:Name="PreviewCard" Height="40" CornerRadius="8" Margin="0,0,0,8" />
							<Border x:Name="PreviewCardHover" Height="40" CornerRadius="8" />
							<Border x:Name="PreviewAccent" Height="10" Width="80" CornerRadius="5" HorizontalAlignment="Left" Margin="0,16,0,0" />
						</StackPanel>
					</Grid>
				</Border>
			</StackPanel>
		</Grid>

		<DockPanel Margin="0,20,0,0">
			<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
				<Button Content="{loc:Tr Btn_Cancel}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="0,0,8,0" IsCancel="True" />
				<Button Content="{loc:Tr Btn_Ok}" Style="{StaticResource AccentButton}" IsDefault="True" Click="OnOkClicked" />
			</StackPanel>
			<Button x:Name="DeleteButton" Content="{loc:Tr Theme_Delete}" Style="{StaticResource AccentButton}" Background="#E5484D" HorizontalAlignment="Left" Click="OnDeleteClicked" Visibility="Collapsed" />
		</DockPanel>
	</StackPanel>
</Window>
