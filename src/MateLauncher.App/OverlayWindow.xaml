<Window x:Class="MateLauncher.App.OverlayWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:controls="clr-namespace:MateLauncher.App.Controls"
		xmlns:loc="clr-namespace:MateLauncher.App.Localization"
		WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False"
		ShowActivated="True" ResizeMode="NoResize" Width="400" SizeToContent="Height" KeyDown="OnKeyDown"
		Foreground="{DynamicResource TextBrush}">
	<Border Margin="16" CornerRadius="18" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
		<Border.Effect>
			<DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.75" Color="Black" />
		</Border.Effect>
		<StackPanel>
			<Border Background="{DynamicResource SidebarBrush}" Padding="18,12" Cursor="SizeAll" MouseLeftButtonDown="OnHeaderMouseDown" ToolTip="{loc:Tr Overlay_Move}">
				<Grid>
					<StackPanel Orientation="Horizontal">
						<controls:MateLogo Width="26" Height="26" />
						<TextBlock Text="MateLauncher" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0" />
					</StackPanel>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
						<TextBlock x:Name="ClockText" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
						<TextBlock Text="&#xE76F;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center" />
						<Button Click="OnCloseClicked" ToolTip="{loc:Tr Overlay_Close}" Background="Transparent" BorderThickness="0" Padding="8,2" Margin="12,0,0,0" Cursor="Hand" Foreground="{DynamicResource MutedTextBrush}"><TextBlock Text="&#xE8BB;" FontFamily="{StaticResource IconFont}" FontSize="12" /></Button>
					</StackPanel>
					<Rectangle Height="2" VerticalAlignment="Bottom" Margin="-18,0,-18,-12">
						<Rectangle.Fill>
							<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
								<GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
								<GradientStop Color="#00000000" Offset="1" />
							</LinearGradientBrush>
						</Rectangle.Fill>
					</Rectangle>
				</Grid>
			</Border>

			<StackPanel Margin="22,20,22,20">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Border Width="72" Height="108" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource CardBrush}">
						<Border.Effect>
							<DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="Black" />
						</Border.Effect>
						<Image Source="{Binding ActiveGame.CoverImagePath}" Stretch="UniformToFill" />
					</Border>
					<StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
						<TextBlock x:Name="StateText" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
						<TextBlock x:Name="GameNameText" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0" />
						<TextBlock x:Name="PlatformText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" />
					</StackPanel>
				</Grid>

				<Border CornerRadius="12" Background="{DynamicResource CardBrush}" Padding="18,14" Margin="0,20,0,0">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center">
							<TextBlock Text="{loc:Tr Overlay_Session}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
							<TextBlock x:Name="SessionText" FontFamily="{StaticResource MonoFont}" FontSize="30" FontWeight="Bold" Margin="0,2,0,0" />
						</StackPanel>
						<StackPanel Grid.Column="1" VerticalAlignment="Center">
							<TextBlock Text="{loc:Tr Overlay_Today}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" />
							<TextBlock x:Name="TodayText" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0" />
							<TextBlock Text="{loc:Tr Overlay_Total}" FontFamily="{StaticResource MonoFont}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" Margin="0,8,0,0" />
							<TextBlock x:Name="TotalText" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2,0,0" />
						</StackPanel>
					</Grid>
				</Border>

				<StackPanel Orientation="Horizontal" Margin="0,18,0,0">
					<Button Style="{StaticResource AccentButton}" Click="OnOpenLauncherClicked">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
							<TextBlock Text="{loc:Tr Overlay_Back}" VerticalAlignment="Center" />
						</StackPanel>
					</Button>
					<Button x:Name="StopButton" Style="{StaticResource AccentButton}" Background="#E5484D" Margin="8,0,0,0" Click="OnStopClicked" Visibility="Collapsed">
						<StackPanel Orientation="Horizontal">
							<TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
							<TextBlock Text="{loc:Tr Btn_Stop}" VerticalAlignment="Center" />
						</StackPanel>
					</Button>
				</StackPanel>

				<TextBlock x:Name="HintText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,14,0,0" />
			</StackPanel>
		</StackPanel>
	</Border>
</Window>
