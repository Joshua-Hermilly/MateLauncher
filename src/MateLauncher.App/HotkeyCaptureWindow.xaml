<Window x:Class="MateLauncher.App.HotkeyCaptureWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:loc="clr-namespace:MateLauncher.App.Localization"
		Title="{loc:Tr Hotkey_Title}" Width="440" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
		Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
		PreviewKeyDown="OnPreviewKeyDown">
	<StackPanel Margin="24">
		<TextBlock Text="{loc:Tr Hotkey_Prompt}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
		<Border CornerRadius="10" Background="{DynamicResource CardBrush}" Padding="16" Margin="0,16,0,0">
			<TextBlock x:Name="CombinationText" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
		</Border>
		<TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
			<Button Content="{loc:Tr Btn_Cancel}" Style="{StaticResource AccentButton}" Background="#33FFFFFF" Margin="0,0,8,0" IsCancel="True" Focusable="False" />
			<Button x:Name="OkButton" Content="{loc:Tr Btn_Ok}" Style="{StaticResource AccentButton}" Click="OnOkClicked" IsEnabled="False" Focusable="False" />
		</StackPanel>
	</StackPanel>
</Window>
